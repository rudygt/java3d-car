<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.rdebug</groupId>
    <artifactId>Java3dCar</artifactId>
    <version>1.0-SNAPSHOT</version>

    <repositories>
        <!-- JogAmp's Java3D 1.7.x is not published to Maven Central; the jars
             from jogamp.org/deployment/java3d/1.7.1-final are vendored into
             lib/ as a project-local repository. -->
        <repository>
            <id>project-lib</id>
            <url>file://${project.basedir}/lib</url>
        </repository>
    </repositories>

    <dependencies>

        <dependency>
            <groupId>org.jogamp.java3d</groupId>
            <artifactId>j3dcore</artifactId>
            <version>1.7.1</version>
        </dependency>

        <dependency>
            <groupId>org.jogamp.java3d</groupId>
            <artifactId>j3dutils</artifactId>
            <version>1.7.1</version>
        </dependency>

        <dependency>
            <groupId>org.jogamp.java3d</groupId>
            <artifactId>vecmath</artifactId>
            <version>1.7.1</version>
        </dependency>

        <dependency>
            <groupId>org.jogamp.gluegen</groupId>
            <artifactId>gluegen-rt-main</artifactId>
            <version>2.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.jogamp.jogl</groupId>
            <artifactId>jogl-all-main</artifactId>
            <version>2.6.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>test.Main</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- JOGL's AWT interop reflects into these JDK
                                 internals; required on JDK 16+ where strong
                                 encapsulation blocks it (harmless on 11). -->
                            <Add-Exports>java.desktop/sun.awt java.desktop/sun.java2d</Add-Exports>
                        </manifestEntries>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>1.2.1</version>
                <configuration>
                    <mainClass>test.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>